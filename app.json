{
  "expo": {
    "name": "Birthmark",
    "slug": "birthmark",
    "owner": "birthmark",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/ios-icon-1024.png",
    "scheme": "birthmark",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF3EC",
    "ios": {
      "icon": "./assets/ios-icon-1024.png",
      "bundleIdentifier": "com.htpdevs.birthmark",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["tel"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.htpdevs.birthmark",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E8775A",
        "foregroundImage": "./assets/android-foreground-432.png",
        "backgroundImage": "./assets/android-background-432.png",
        "monochromeImage": "./assets/android-monochrome-432.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF3EC",
          "image": "./assets/mark-1024.png",
          "imageWidth": 76
        }
      ],
      "./plugins/withNoUserScriptSandboxing",
      "./plugins/withDebugOnlyInternet"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "071d5405-361e-4795-b9da-818cdafe463d"
      }
    }
  }
}
